<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play Games (Rise of Davraz). Written by hand from the plugin's template-AndroidManifest.txt
     (same result as Window > Google Play Games > Setup). The App ID is PlayConfig.PlayGamesAppId. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.google.example.games.mainlibproj"
    android:versionCode="1"
    android:versionName="1.0" >

    <!-- Nearby Connections is not used: make sure none of its permissions reach the app (privacy / Data safety).
         android.permission.BLUETOOTH is NOT removed: the app had it before Play Games (Unity audio / voice chat). -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" tools:node="remove" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />

    <application>

        <!-- From res/values/games-ids.xml: a resource keeps it a string (a bare number here is compiled as a float). -->
        <meta-data android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/zm_games_app_id" />

        <!-- Keep track of which plugin is being used -->
        <meta-data android:name="com.google.android.gms.games.unityVersion"
            android:value="2.3.0" />

        <activity android:name="com.google.games.bridge.NativeBridgeActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
    </application>
</manifest>
