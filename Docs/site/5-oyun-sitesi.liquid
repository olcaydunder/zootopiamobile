{%- comment -%}
  Rise of Davraz – oyun tanıtım sayfası (Shopify "Özel Liquid" bölümü).
  Resimler Shopify > İçerik > Dosyalar'a şu adlarla yüklenmeli:
  rod-feature.png, rod-icon.png, rod-lobi.jpg, rod-kutular.jpg
  Oyun herkese açık yayına çıkınca aşağıdaki satırı true yap.
{%- endcomment -%}
{%- assign rod_yayinda = false -%}
{%- assign rod_play = 'https://play.google.com/store/apps/details?id=com.zootopiayazilim.riseofdavraz' -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Russo+One&display=swap" rel="stylesheet">
<style>
#rod{--ink:#0d1019;--bg:#141827;--panel:#1c2133;--line:#2b3149;--text:#eef0f6;--muted:#a7adc4;--gold:#ffc83a;--gold2:#f39a1d;--dusk:#3a2342;
  background:var(--bg);color:var(--text);font-family:Barlow,system-ui,sans-serif;font-size:17px;line-height:1.6;overflow:hidden}
#rod *{box-sizing:border-box}
#rod a{color:var(--gold);text-decoration:none}
#rod a:hover{text-decoration:underline}
#rod h2,#rod h3{font-family:"Russo One",Barlow,sans-serif;font-weight:400;letter-spacing:.02em;color:var(--text);margin:0}
#rod h2{font-size:clamp(26px,4vw,38px);line-height:1.15}
#rod h3{font-size:19px;line-height:1.25}
#rod p{margin:0}
#rod .w{max-width:1120px;margin:0 auto;padding:0 20px}
#rod .sec{padding:72px 0}
#rod .kicker{font-family:"Russo One",sans-serif;font-size:13px;letter-spacing:.18em;color:var(--gold);margin-bottom:10px}
#rod .lead{color:var(--muted);max-width:640px;margin-top:12px}
/* hero */
#rod .hero{background:radial-gradient(ellipse at 50% 85%,rgba(243,154,29,.35),transparent 60%),linear-gradient(180deg,#1b1a33 0%,var(--dusk) 70%,var(--bg) 100%);padding:48px 0 64px;text-align:center}
#rod .hero img.logo{width:100%;max-width:880px;height:auto;display:block;margin:0 auto;border-radius:18px}
#rod .hero .tag{font-family:"Russo One",sans-serif;font-size:clamp(22px,3.4vw,34px);line-height:1.2;margin:28px auto 10px;max-width:820px}
#rod .hero .sub{color:#d6d9e8;max-width:640px;margin:0 auto}
#rod .cta{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:28px}
#rod .btn{display:inline-flex;align-items:center;gap:10px;padding:14px 26px;border-radius:12px;font-weight:600;font-size:17px;line-height:1;border:2px solid transparent;transition:transform .15s ease}
#rod .btn:hover{text-decoration:none;transform:translateY(-2px)}
#rod .btn.main{background:linear-gradient(180deg,var(--gold),var(--gold2));color:#1a1206;box-shadow:0 8px 24px rgba(243,154,29,.35)}
#rod .btn.alt{border-color:rgba(255,255,255,.35);color:var(--text)}
#rod .btn small{font-weight:500;opacity:.75;font-size:13px}
#rod .chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:22px}
#rod .chip{font-size:14px;color:#dfe2ef;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);padding:6px 12px;border-radius:999px}
/* numbers */
#rod .nums{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:16px;overflow:hidden;margin-top:-28px;position:relative}
#rod .num{background:var(--panel);padding:18px 10px;text-align:center}
#rod .num b{display:block;font-family:"Russo One",sans-serif;font-weight:400;font-size:30px;color:var(--gold);line-height:1.1}
#rod .num span{font-size:14px;color:var(--muted)}
/* features */
#rod .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:32px}
#rod .card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:22px}
#rod .card svg{width:34px;height:34px;color:var(--gold);margin-bottom:12px}
#rod .card p{color:var(--muted);margin-top:8px;font-size:16px}
/* screenshots */
#rod .shots{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:32px}
#rod figure{margin:0}
#rod figure img{width:100%;height:auto;display:block;border-radius:14px;border:1px solid var(--line)}
#rod figcaption{color:var(--muted);font-size:15px;margin-top:8px}
/* maps */
#rod .maps{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:28px}
#rod .map{background:var(--panel);border:1px solid var(--line);border-left:4px solid var(--gold);border-radius:12px;padding:14px 16px}
#rod .map b{font-family:"Russo One",sans-serif;font-weight:400;letter-spacing:.03em}
#rod .map span{display:block;color:var(--muted);font-size:14px}
/* faq */
#rod details{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:0 18px;margin-top:10px}
#rod summary{cursor:pointer;padding:16px 0;font-weight:600;list-style:none;display:flex;justify-content:space-between;gap:12px}
#rod summary::-webkit-details-marker{display:none}
#rod summary:after{content:"+";color:var(--gold);font-family:"Russo One",sans-serif;font-size:20px;line-height:1}
#rod details[open] summary:after{content:"–"}
#rod details p{color:var(--muted);padding:0 0 16px}
/* test box */
#rod .box{background:linear-gradient(135deg,#2a1f3d,#1c2133);border:1px solid #4a3a5f;border-radius:20px;padding:32px;display:grid;grid-template-columns:auto 1fr auto;gap:24px;align-items:center}
#rod .box img{width:84px;height:84px;border-radius:20px;display:block}
#rod .box p{color:#cfd3e4;margin-top:6px}
/* footer */
#rod .foot{border-top:1px solid var(--line);padding:28px 0 36px;color:var(--muted);font-size:14px}
#rod .foot nav{display:flex;flex-wrap:wrap;gap:8px 20px;margin-bottom:10px}
#rod .foot nav a{color:var(--text)}
@media (max-width:860px){
  #rod .grid,#rod .maps{grid-template-columns:1fr 1fr}
  #rod .nums{grid-template-columns:repeat(3,1fr)}
  #rod .box{grid-template-columns:1fr;text-align:center}
  #rod .box img{margin:0 auto}
}
@media (max-width:560px){
  #rod{font-size:16px}
  #rod .sec{padding:52px 0}
  #rod .w{padding:0 16px}
  #rod .grid,#rod .maps,#rod .shots{grid-template-columns:1fr}
  #rod .nums{grid-template-columns:repeat(2,1fr)}
  #rod .num:last-child{grid-column:1/-1}
  #rod .btn{width:100%;justify-content:center}
}
</style>

<div id="rod" lang="tr">

  <section class="hero">
    <div class="w">
      <img class="logo" src="{{ 'rod-feature.png' | file_url }}" alt="Rise of Davraz" width="1024" height="500">
      <p class="tag">Gerçek Türk şehirlerinde 25 kişilik battle royale</p>
      <p class="sub">Uçaktan istediğin yere atla, paraşütle in, silahını ve zırhını topla. Güvenli bölge daraldıkça rakiplerini ele, ayakta kalan son kişi sen ol.</p>
      <div class="cta">
        {%- if rod_yayinda -%}
        <a class="btn main" href="{{ rod_play }}" target="_blank" rel="noopener">Google Play'den ücretsiz indir</a>
        {%- else -%}
        <a class="btn main" href="mailto:zootopiayazilim@gmail.com?subject=Rise%20of%20Davraz%20-%20Test%C3%A7i%20olmak%20istiyorum&amp;body=Merhaba%2C%20Rise%20of%20Davraz%20testine%20kat%C4%B1lmak%20istiyorum.%0AGoogle%20Play%27de%20kulland%C4%B1%C4%9F%C4%B1m%20Gmail%20adresim%3A%20">Testçi ol, önce sen oyna</a>
        <a class="btn alt" href="{{ rod_play }}" target="_blank" rel="noopener">Google Play sayfası <small>yakında herkese açık</small></a>
        {%- endif -%}
      </div>
      <div class="chips">
        <span class="chip">Ücretsiz</span><span class="chip">Android 7.0 ve üzeri</span><span class="chip">Çevrimiçi ya da internetsiz</span><span class="chip">Türkçe</span>
      </div>
    </div>
  </section>

  <div class="w">
    <div class="nums">
      <div class="num"><b>25</b><span>oyuncu</span></div>
      <div class="num"><b>6</b><span>gerçek harita</span></div>
      <div class="num"><b>7</b><span>oyun modu</span></div>
      <div class="num"><b>29</b><span>silah modeli</span></div>
      <div class="num"><b>24</b><span>karakter</span></div>
    </div>
  </div>

  <section class="sec">
    <div class="w">
      <p class="kicker">OYUN</p>
      <h2>Mahallen artık savaş alanı</h2>
      <p class="lead">Haritalar gerçek sokak, bina ve arazi verisinden oluşturuldu. Tanıdığın caddede pusu kur, bildiğin tepeden nişan al.</p>
      <div class="grid">
        <div class="card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
          <h3>Gerçek haritalar</h3>
          <p>İstanbul'dan Isparta'ya, Elazığ'a: altı gerçek bölge, gerçek sokaklar ve binalar.</p>
        </div>
        <div class="card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M15.5 14.3A5 5 0 0 1 21 19"/></svg>
          <h3>Solo, Duo, Squad</h3>
          <p>Battle royale'in yanında 5v5 Takım Ölüm Maçı, Hakimiyet, Herkes Tek ve Soygun.</p>
        </div>
        <div class="card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="8" width="14" height="11" rx="3"/><path d="M12 4v4M9 13h.01M15 13h.01M9.5 16.5h5"/></svg>
          <h3>Çevrimiçi ya da botlarla</h3>
          <p>Arkadaşlarınla oda kur ya da hızlı maça gir. Eksik yerleri botlar doldurur; internet yoksa botlara karşı oyna.</p>
        </div>
        <div class="card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="7"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/><circle cx="12" cy="12" r="1.5"/></svg>
          <h3>Silahını kendin kur</h3>
          <p>Tabanca, hafif makineli, taarruz tüfeği, pompalı ve keskin nişancı. Susturucu, dürbün, tutamak ve parlayan kamuflajlar.</p>
        </div>
        <div class="card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5c3 1.5 13 1.5 16 0v6c0 5-4 8-8 9-4-1-8-4-8-9V5z"/><path d="M8.5 11.5h2M13.5 11.5h2M10 16c1.2.8 2.8.8 4 0"/></svg>
          <h3>Karakterler ve maskeler</h3>
          <p>Askerler, operatörler, özel tim. Kedi, kurt, aslan ve ejderha maskeleriyle tarzını seç.</p>
        </div>
        <div class="card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z"/><path d="M7 6H4v1a3 3 0 0 0 3 3M17 6h3v1a3 3 0 0 1-3 3"/></svg>
          <h3>Arkadaşlar ve ödüller</h3>
          <p>Arkadaş ekle, mesajlaş, hediye gönder. Günlük ve haftalık görevler, şans çarkı ve kutular.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="w">
      <p class="kicker">EKRANLAR</p>
      <h2>Oyundan görüntüler</h2>
      <div class="shots">
        <figure><img src="{{ 'rod-lobi.jpg' | file_url }}" alt="Rise of Davraz lobi ekranı" loading="lazy" width="1600" height="900"><figcaption>Lobi: haritanı ve modunu seç, tek dokunuşla maça gir.</figcaption></figure>
        <figure><img src="{{ 'rod-kutular.jpg' | file_url }}" alt="Rise of Davraz mağaza, kutular" loading="lazy" width="1600" height="900"><figcaption>Kutular: her kutunun olasılıkları satın almadan önce görünür.</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="w">
      <p class="kicker">HARİTALAR</p>
      <h2>Altı gerçek bölge</h2>
      <div class="maps">
        <div class="map"><b>Ekşioğlu</b><span>Çekmeköy, İstanbul</span></div>
        <div class="map"><b>Kafeler Caddesi</b><span>Merkez, Isparta</span></div>
        <div class="map"><b>Davraz Mahallesi</b><span>Merkez, Isparta</span></div>
        <div class="map"><b>Senir Kasabası</b><span>Keçiborlu, Isparta</span></div>
        <div class="map"><b>Pınar Evleri</b><span>Tepecik, Senir / Keçiborlu</span></div>
        <div class="map"><b>Fırat Üniversitesi</b><span>Rektörlük Kampüsü, Elazığ</span></div>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="w">
      <p class="kicker">SIK SORULANLAR</p>
      <h2>Merak ettiklerin</h2>
      <details><summary>Oyun ücretsiz mi?</summary><p>Evet. İstersen Kredi paketleri alabilir ya da reklam izleyerek Kredi kazanabilirsin; ikisi de zorunlu değil. Kutu, şans çarkı ve çekilişin olasılıkları satın almadan önce oyunda gösterilir.</p></details>
      <details><summary>İnternetsiz oynayabilir miyim?</summary><p>Evet, botlara karşı tek başına oynayabilirsin. Çevrimiçi maçlar, arkadaşlar ve mesajlar için internet gerekir.</p></details>
      <details><summary>Hangi telefonlarda çalışır?</summary><p>Android 7.0 ve üzeri telefonlarda. İndirme boyutu yaklaşık 130 MB. Grafik kalitesini oyunda Ayarlar → Ses ve Grafikler'den telefonuna göre ayarlayabilirsin.</p></details>
      <details><summary>Telefon değiştirirsem ne olur?</summary><p>Google Play Games ile giriş yaptıysan oyuncu kodun, arkadaşların ve mesajların yeni telefonda geri gelir. Kredi, eşyalar ve ilerleme şimdilik yalnızca telefonda saklanır ve taşınmaz.</p></details>
      <details><summary>Satın aldığım Kredi gelmedi, ne yapmalıyım?</summary><p>Google Play sipariş numaranla <a href="mailto:zootopiayazilim@gmail.com?subject=Rise%20of%20Davraz%20-%20Sat%C4%B1n%20alma">zootopiayazilim@gmail.com</a> adresine yaz, inceleyip çözelim. İadeler Google Play'in kurallarına göre Google Play üzerinden yapılır.</p></details>
      <details><summary>Hesabımı ve verilerimi nasıl silerim?</summary><p>Oyunda Ayarlar → Gizlilik → "Hesabımı ve tüm verilerimi sil" ile hemen silebilirsin. Oyun yüklü değilse <a href="/pages/rise-of-davraz-hesap-silme">hesap silme sayfasındaki</a> adımları izle.</p></details>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="w">
      <div class="box">
        <img src="{{ 'rod-icon.png' | file_url }}" alt="" width="84" height="84">
        <div>
          {%- if rod_yayinda -%}
          <h3>Bir sorun mu var, bir önerin mi?</h3>
          <p>Oyunda Ayarlar → Gizlilik'te yazan oyuncu kodunla birlikte bize yaz; en kısa sürede dönelim.</p>
          {%- else -%}
          <h3>Testçi ol, oyunu herkesten önce oyna</h3>
          <p>Google Play'de kullandığın Gmail adresini yaz, seni test listesine ekleyelim. Davet bağlantısını açıp "Test kullanıcısı ol"a basman yeterli.</p>
          {%- endif -%}
        </div>
        {%- if rod_yayinda -%}
        <a class="btn main" href="mailto:zootopiayazilim@gmail.com?subject=Rise%20of%20Davraz%20-%20Destek">Destek iste</a>
        {%- else -%}
        <a class="btn main" href="mailto:zootopiayazilim@gmail.com?subject=Rise%20of%20Davraz%20-%20Test%C3%A7i%20olmak%20istiyorum&amp;body=Merhaba%2C%20Rise%20of%20Davraz%20testine%20kat%C4%B1lmak%20istiyorum.%0AGoogle%20Play%27de%20kulland%C4%B1%C4%9F%C4%B1m%20Gmail%20adresim%3A%20">Testçi ol</a>
        {%- endif -%}
      </div>
    </div>
  </section>

  <footer class="foot">
    <div class="w">
      <nav>
        <a href="/pages/rise-of-davraz-gizlilik">Gizlilik Politikası</a>
        <a href="/pages/rise-of-davraz-kullanim-kosullari">Kullanım Koşulları</a>
        <a href="/pages/rise-of-davraz-hesap-silme">Hesap ve Veri Silme</a>
        <a href="mailto:zootopiayazilim@gmail.com">zootopiayazilim@gmail.com</a>
      </nav>
      <p>© 2026 Zootopia Yazılım · Yapımcı: Olcay Yasin Dünder · Harita verileri © OpenStreetMap katkıcıları</p>
    </div>
  </footer>

</div>
